{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "视频下载器",
  "version": "0.2.0",
  "identifier": "com.local.video-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1432",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "视频下载器",
        "width": 1200,
        "height": 780,
        "minWidth": 880,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#111318",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: https: http:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; media-src 'self' asset: http://asset.localhost;",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "中文桌面视频下载器，基于 yt-dlp",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tools/": "tools/",
      "resources/components.json": "components.json",
      "resources/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "resources/licenses/": "licenses/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "startMenuFolder": "视频下载器"
      }
    }
  }
}